# Production reverse-proxy origin, including scheme and optional port.
WEBOS_APP_ORIGIN=https://home.example.com

# HTTPS deployments use secure cookies. Local npm run dev configures HTTP cookies.
WEBOS_SECURE_COOKIES=true

# Optional fixed token used only while creating the first owner account.
# WEBOS_SETUP_TOKEN=replace-with-a-long-random-value

# Session lifetime and inactivity limit in milliseconds.
WEBOS_SESSION_TTL_MS=43200000
WEBOS_IDLE_TIMEOUT_MS=1800000

# Server binding and persistent state directory.
HOST=0.0.0.0
PORT=8080
WEBOS_DATA_DIR=/app/data
